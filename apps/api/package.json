{
  "name": "@dn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "ingest": "node --env-file-if-exists=.env dist/cli/ingest.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "metrics": "node --env-file=.env --import tsx metrics/run.ts",
    "test":"node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@dn/shared": "*",
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "postgres": "^3.4.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "autocannon": "^8.0.0"
  }
}
